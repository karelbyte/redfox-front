# Cuenta con la que las pruebas e2e inician sesión.
# Copia este archivo a .env.e2e y rellena la contraseña.
# .env.e2e lo ignora git: nunca subas credenciales al repositorio.

E2E_TENANT=david-test-enterprise
E2E_EMAIL=davidjesus1284@gmail.com
E2E_PASSWORD=

# Símbolo de moneda que debe mostrar esa organización.
# Por defecto S/ (Perú). Para una organización mexicana: $
# E2E_CURRENCY_SYMBOL=S/
